# Database
DATABASE_URL=postgresql://tet:tet_secret@localhost:5432/tet_db
POSTGRES_DB=tet_db
POSTGRES_USER=tet
POSTGRES_PASSWORD=tet_secret

# API
PORT=3001
API_URL=http://localhost:3001

# Next.js (used server-side to proxy /api/* to backend)
# In Docker: API_URL=http://api:3001
# In dev:    API_URL=http://localhost:3001

# JWT / Session
JWT_SECRET=change_me_in_production_32_chars_min
SESSION_SECRET=change_me_in_production_32_chars_min

# Admin account (used for seeding)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin_password_change_me

# App
APP_URL=http://localhost:3000
NODE_ENV=development

# Extraction IA depuis affiche/texte (optionnel — la saisie manuelle marche sans)
# API compatible OpenAI (/v1/chat/completions). Au choix :
#  - DeepSeek (cloud, pas cher, texte uniquement) :
#      LLM_BASE_URL=https://api.deepseek.com/v1
#      LLM_MODEL=deepseek-chat
#      LLM_API_KEY=sk-...
#  - Modèle local sur le VPS via Ollama (gratuit) :
#      LLM_BASE_URL=http://host.docker.internal:11434/v1   (ou http://ollama:11434/v1)
#      LLM_MODEL=qwen2.5            (texte)  /  llava ou qwen2-vl (affiche = vision)
#      LLM_API_KEY=                 (vide, Ollama n'exige pas de clé)
# ⚠️ La lecture d'une AFFICHE (image) exige un modèle VISION. DeepSeek-chat ne lit que le texte collé.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Image storage (absolute path on host, mapped as Docker volume)
UPLOADS_DIR=./uploads
